# cp .env.example .env && chmod 600 .env
# Used by make and scripts: KEY=value, no quotes, spaces, or `$` in values.

# zot accounts: admin (full), pusher (make images), puller (cluster, read-only)
REGISTRY_ADMIN_PASSWORD=
REGISTRY_PUSHER_PASSWORD=
REGISTRY_PULLER_PASSWORD=

# Redis (required by poll and worker); generate with: openssl rand -hex 32
REDIS_PASSWORD=

# PostgreSQL (required by worker and result); generate the password with: openssl rand -hex 32
POSTGRES_DB=poll
POSTGRES_USER=poll
POSTGRES_PASSWORD=

# Grafana admin password (make monitoring); generate with: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# Cloudflare Tunnel token (make tunnel); optional for internal-only use
CLOUDFLARE_TUNNEL_TOKEN=
